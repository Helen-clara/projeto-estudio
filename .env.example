# Configurações de Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ink_and_glow_db

# Envio de lembretes por e-mail (Nodemailer / SMTP)
# Sem SMTP_HOST, SMTP_USER, SMTP_PASS e SMTP_FROM preenchidos, os lembretes rodam em MODO SIMULAÇÃO
# (nada é enviado; o envio é só registrado no log e no banco como simulado).
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ink & Glow Studio <nao-responda@exemplo.com>"

# Localização do estúdio para a previsão do tempo (Open-Meteo)
CLIMA_LATITUDE=-23.5505
CLIMA_LONGITUDE=-46.6333

# Dados do estúdio exibidos nos lembretes
STUDIO_NOME="Ink & Glow Studio"
STUDIO_ENDERECO="Rua Exemplo, 123 - Centro"

# Sessão: minutos sem atividade até exigir novo login
SESSAO_TIMEOUT_MINUTOS=30

# Lembretes automáticos
LEMBRETE_HORARIO=09:00
LEMBRETE_MAX_TENTATIVAS=3

# Horário de funcionamento do estúdio (agenda). Dias: 0=domingo ... 6=sábado
HORARIO_ABERTURA=09:00
HORARIO_FECHAMENTO=20:00
DIAS_FUNCIONAMENTO=1,2,3,4,5,6
