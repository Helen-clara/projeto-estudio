# Configurações de Conexão com o Banco de Dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ink_and_glow_db

# Envio de lembretes por e-mail (Nodemailer / SMTP)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Ink & Glow Studio <nao-responda@exemplo.com>"

# Localização do estúdio para a previsão do tempo (Open-Meteo)
CLIMA_LATITUDE=-23.5505
CLIMA_LONGITUDE=-46.6333

# Dados do estúdio exibidos nos lembretes
STUDIO_NOME="Ink & Glow Studio"
STUDIO_ENDERECO="Rua Exemplo, 123 - Centro"
