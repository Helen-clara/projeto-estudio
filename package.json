{
  "name": "ink-and-glow-studio",
  "version": "1.0.0",
  "description": "Sistema de Gestão Desktop para Estúdio de Estética e Tatuagem",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy:renderer": "node -e \"const fs=require('fs'); fs.mkdirSync('dist/renderer', {recursive:true}); fs.copyFileSync('src/renderer/index.html', 'dist/renderer/index.html');\"",
    "build": "npm run build:main && npm run build:renderer && npm run copy:renderer",
    "start": "npm run build && electron .",
    "db:init": "node -e \"console.log('Script de inicialização do banco MySQL configurado para a Parte 2.')\""
  },
  "keywords": [
    "electron",
    "typescript",
    "mysql",
    "tattoo",
    "aesthetics",
    "desktop",
    "poo"
  ],
  "author": "Equipe Ink & Glow",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "electron": "^34.2.0",
    "typescript": "^5.7.3"
  }
}
