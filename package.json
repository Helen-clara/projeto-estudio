{
  "name": "ink-and-glow-studio",
  "version": "1.0.0",
  "description": "Sistema de Gestão Desktop para Estúdio de Estética e Tatuagem",
  "main": "dist/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "tsc -p tsconfig.renderer.json",
    "copy:renderer": "node -e \"const fs=require('fs'); fs.mkdirSync('dist/renderer', {recursive:true}); fs.copyFileSync('src/renderer/index.html', 'dist/renderer/index.html');\"",
    "clean": "rimraf dist",
    "build": "npm run clean && npm run build:main && npm run build:renderer && npm run copy:renderer",
    "start": "npm run build && electron .",
    "watch:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "watch:renderer": "tsc -p tsconfig.renderer.json --watch --preserveWatchOutput",
    "dev": "npm run build && concurrently -k -n main,renderer,electron \"npm:watch:main\" \"npm:watch:renderer\" \"electron .\"",
    "db:init": "ts-node scripts/initDb.ts",
    "db:check": "ts-node scripts/checkDb.ts"
  },
  "keywords": [
    "electron",
    "typescript",
    "mysql",
    "tattoo",
    "aesthetics",
    "desktop",
    "poo"
  ],
  "author": "Equipe Ink & Glow",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "mysql2": "^3.12.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "concurrently": "^10.0.7",
    "electron": "^34.2.0",
    "eslint": "^10.15.0",
    "rimraf": "^6.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
